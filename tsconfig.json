{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "composite": true,
    "declarationMap": false,
    "noEmit": true,
    "paths": {
      "@makanmasak/shared-types": ["./packages/shared-types/src"],
      "@makanmasak/shared-types/*": ["./packages/shared-types/src/*"],
      "@makanmasak/database": ["./packages/database/src"],
      "@makanmasak/database/*": ["./packages/database/src/*"],
      "@makanmasak/utils": ["./packages/utils/src"],
      "@makanmasak/utils/*": ["./packages/utils/src/*"]
    }
  },
  "files": [],
  "exclude": ["node_modules", "dist", "legacy", ".wrangler", "**/*.d.ts"],
  "references": [
    {
      "path": "./apps/customer-app"
    },
    {
      "path": "./apps/admin-dashboard"
    },
    {
      "path": "./packages/shared-types"
    },
    {
      "path": "./packages/database"
    },
    {
      "path": "./packages/utils"
    },
    {
      "path": "./packages/queue-core"
    },
    {
      "path": "./packages/queue-service"
    }
  ]
}
