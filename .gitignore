# Git worktrees
.worktrees/

# Local code graph index
.codebase-memory/

# Dependencies
node_modules/
.pnpm-debug.log*

# Package manager lock files (keep pnpm-lock.yaml only)
package-lock.json
npm-shrinkwrap.json
yarn.lock

# Build outputs
dist/
build/
.next/
.nuxt/
coverage/

# Environment files
#
# Team-shared dev defaults (.env.development / .env.test) ARE committed —
# they only contain localhost URLs and feature flags. Individual overrides
# belong in .env.development.local / .env.test.local (ignored below).
# Real secrets (JWT, tokens, keys) go in .env.local or the secret store only.
.env
.env.local
.env.*.local
.env.production
.dev.vars
!.env.development
!.env.test
# Frontend production env files only contain public VITE_* URLs needed by CI.
!apps/admin-dashboard/.env.production
!apps/customer-app/.env.production
!apps/kitchen-display/.env.production
!apps/management-portal/.env.production
!apps/onboarding-app/.env.production

