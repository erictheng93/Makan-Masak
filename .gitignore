*-final*.txt
tmpclaude-*

# Git worktrees
.worktrees/
# Claude Code spawns agent worktrees here. They carry a full node_modules,
# so an `add -A` from any session would commit one into the repo.
.claude/worktrees/
.superpowers/
.gstack/
.impeccable/

# E2E integration test auth cache
tests/e2e/.tmp/
.claude/scheduled_tasks.lock

# Database dumps from `pnpm db:backup` (plaintext rows, never commit).
# scripts/backup-database.ts refuses to run if this entry goes missing.
backups/

# Forensic dumps taken during an incident (see docs/runbooks/backup-restore-runbook.md)
forensics-*.json

# Adversarial security audit reports. These carry working exploit steps --
# attack requests, the file:line of each sink, and which guard is missing --
# against a repo that is public. Findings belong in issues and in the fix's
# own commit message, where they are scoped to one defect; the assembled
# report is a map for whoever reads it first.
docs/security/*-audit-*.html
docs/security/*-audit-*.md

# Staging/prod secret bundles (script-managed, never commit)
.staging.secrets.env
.prod.secrets.env
.staging.secrets.generated.json
.prod.secrets.generated.json
