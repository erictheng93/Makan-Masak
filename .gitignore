nul
**/nul
vitest.workspace.ts.bak


# Turbo cache
.turbo/

# Generated Vue/TypeScript files (should not be in source directories)
**/*.vue.js
**/*.vue.d.ts
**/src/**/*.d.ts
**/src/**/*.js
!**/src/**/*.config.js
!**/src/**/*.test.js
!**/src/**/*.spec.js
