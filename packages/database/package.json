{
  "name": "@makanmasak/database",
  "version": "1.0.0",
  "description": "Database layer with Drizzle ORM for MakanMasak",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "dev": "tsup --no-clean && tsup --watch --no-clean",
    "test": "cross-env NODE_OPTIONS=\"--max-old-space-size=6144 --expose-gc\" vitest run",
    "test:run": "cross-env NODE_OPTIONS=\"--max-old-space-size=6144 --expose-gc\" vitest run",
    "test:watch": "cross-env NODE_OPTIONS=\"--max-old-space-size=6144 --expose-gc\" vitest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=\"--max-old-space-size=6144 --expose-gc\" vitest run --coverage",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@makanmasak/utils": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^25.0.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.6",
    "miniflare": "^3.20250718.3",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@makanmasak/queue-core": "workspace:*",
    "@makanmasak/shared-types": "workspace:*"
  }
}
