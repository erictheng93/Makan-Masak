{
  "name": "@makanmasak/queue-core",
  "version": "1.0.0",
  "description": "MakanMasak Queue System - Core Types and Interfaces",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "queue",
    "restaurant",
    "types"
  ],
  "author": "MakanMasak Team",
  "license": "MIT",
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@makanmasak/shared-types": "workspace:*",
    "zod": "^4.4.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js"
    },
    "./validators": {
      "types": "./dist/validators/index.d.ts",
      "import": "./dist/validators/index.js",
      "require": "./dist/validators/index.js"
    },
    "./performance/queue-cache": {
      "types": "./dist/performance/queue-cache.d.ts",
      "import": "./dist/performance/queue-cache.js",
      "require": "./dist/performance/queue-cache.js"
    },
    "./print": {
      "types": "./dist/print/index.d.ts",
      "import": "./dist/print/index.js",
      "require": "./dist/print/index.js"
    }
  }
}
