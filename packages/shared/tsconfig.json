{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "composite": false,
    "declaration": false
  },
  "include": [
    "components/**/*.ts",
    "components/**/*.vue",
    "composables/**/*.ts",
    "directives/**/*.ts",
    "plugins/**/*.ts",
    "services/**/*.ts",
    "stores/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "examples", "src/i18n", "**/*.test.ts"]
}
