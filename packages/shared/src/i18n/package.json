{
  "name": "@makanmasak/i18n",
  "version": "1.0.0",
  "description": "Shared internationalization resources for MakanMasak platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./static-messages": {
      "import": "./dist/static-messages.js",
      "types": "./dist/static-messages.d.ts"
    },
    "./locale-manager": {
      "import": "./dist/locale-manager.js",
      "types": "./dist/locale-manager.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./locales/*": "./src/locales/*"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src",
    "test": "vitest run --root ../.. src/i18n/src/index.test.ts",
    "test:watch": "vitest --root ../.. src/i18n/src/index.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vue-i18n": "^11.4.14"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@types/node": "^25.0.5"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  }
}
