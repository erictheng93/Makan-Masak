{
  "name": "makanmasak",
  "version": "2.1.0",
  "description": "智慧雲端點餐平台 - 基於Cloudflare生態系統",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=!@makanmasak/print-agent --concurrency=20",
    "dev:print-agent": "turbo run dev --filter=@makanmasak/print-agent",
    "dev:core": "turbo run dev --filter=!@makanmasak/image-processor --filter=!@makanmasak/print-agent --concurrency=20",
    "dev:customer": "turbo run dev --filter=./apps/customer-app",
    "dev:admin": "turbo run dev --filter=./apps/admin-dashboard",
    "dev:api": "turbo run dev --filter=./apps/api",
    "dev:kitchen": "turbo run dev --filter=./apps/kitchen-display",
    "dev:management": "turbo run dev --filter=./apps/management-portal",
    "dev:management-api": "turbo run dev --filter=./apps/management-api",
    "dev:management:all": "turbo run dev --filter=./apps/management-portal --filter=./apps/management-api",
    "build": "turbo run build",
    "build:customer": "turbo run build --filter=./apps/customer-app",
    "build:admin": "turbo run build --filter=./apps/admin-dashboard",
    "preview": "pnpm -r run preview",
    "typecheck": "turbo run typecheck",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "lint": "turbo run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "verify": "bash scripts/verify.sh",
    "verify:push": "bash scripts/verify.sh --full",
    "test": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run",
    "test:unit": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test --project=integration",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run --coverage",
    "test:watch": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest --watch",
    "test:kitchen": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run apps/kitchen-display",
    "test:admin": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run apps/admin-dashboard",
    "test:api": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run apps/api",
    "test:packages": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run --project=@makanmasak/auth-client --project=@makanmasak/database --project=@makanmasak/queue-core --project=@makanmasak/queue-service --project=@makanmasak/utils --project=shared --passWithNoTests",
    "test:batch1": "pnpm test:kitchen && pnpm test:admin",
    "test:batch2": "pnpm test:api && pnpm test:packages",
    "test:all": "pnpm test:batch1 && pnpm test:batch2",
    "test:realtime": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run --project=@makanmasak/realtime",
    "test:features": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run apps/api/src/features apps/admin-dashboard/src apps/kitchen-display/src apps/customer-app/src",
    "test:workers": "cross-env NODE_OPTIONS='--max-old-space-size=4096' vitest run tests/unit/workers --passWithNoTests",
    "test:integration": "pnpm test:real-integration",
    "test:real-integration": "cross-env NODE_OPTIONS='--max-old-space-size=8192' turbo run test:real-integration --continue=dependencies-successful --filter=./apps/api --filter=./apps/admin-dashboard --filter=./apps/customer-app --filter=./apps/image-processor --filter=./apps/kitchen-display --filter=./apps/management-api",
    "test:workers:integration": "node -e \"const fs=require('fs'); const path='tests/integration/workers'; if (!fs.existsSync(path)) { console.log('No worker integration tests present under tests/integration/workers'); process.exit(0); } console.error('Worker integration tests are present, but test:workers:integration needs a real Wrangler 4 runner.'); process.exit(1);\"",
    "test:ci": "pnpm run test:unit && pnpm run test:e2e",
    "test:ci-guards": "node scripts/run-guard-tests.cjs",
    "db:generate": "cd packages/database && npx drizzle-kit generate",
    "db:migrate:local": "pnpm db:migrate:local:api && pnpm db:migrate:local:mgmt",
    "db:migrate:local:api": "wrangler d1 migrations apply makanmakan-local --local --persist-to ./.wrangler/shared-state --config=./apps/api/wrangler.toml",
    "db:migrate:local:mgmt": "wrangler d1 migrations apply makanmakan-management-local --local --persist-to ./.wrangler/shared-state --config=./apps/management-api/wrangler.toml && wrangler d1 migrations apply makanmakan-local --local --persist-to ./.wrangler/shared-state --config=./apps/management-api/wrangler.toml",
    "db:migrate:prod": "wrangler d1 migrations apply makanmasak-prod --remote --env production --config=./apps/api/wrangler.toml",
    "db:migrate:prod:mgmt": "wrangler d1 migrations apply makanmasak-management-prod --remote --env production --config=./apps/management-api/wrangler.toml",
    "db:reset:local": "rm -rf .wrangler/shared-state/v3/d1/ apps/api/.wrangler/state/v3/d1/ apps/management-api/.wrangler/state/v3/d1/ && pnpm db:migrate:local",
    "db:seed:local": "wrangler d1 execute makanmakan-local --local --persist-to ./.wrangler/shared-state --file=./scripts/seed-local.sql --config=./apps/api/wrangler.toml",
    "db:backup": "npx tsx scripts/backup-database.ts",
    "db:test-migrations": "npx tsx scripts/test-migrations-v2.ts",
    "setup:secrets": "npx tsx scripts/setup-secrets.ts",
    "script": "npx tsx",
    "check:prod-config": "node scripts/check-production-config.cjs",
    "check:vitest-results": "node scripts/check-vitest-results.cjs",
    "check:migration-dual-track": "node scripts/check-migration-dual-track.cjs",
    "check:strict-tables": "node scripts/check-strict-tables.cjs",
    "audit:qr-format": "npx tsx scripts/audit-qr-format.ts",
    "check:no-test-doubles": "node scripts/check-no-test-doubles.cjs",
    "check:test-scripts": "node scripts/check-package-test-scripts.cjs",
    "check:no-automated-destructive-wrangler": "node scripts/check-no-automated-destructive-wrangler.cjs",
    "check:design-palette": "node scripts/check-design-palette.cjs",
    "check:ui-reachability": "node scripts/check-ui-reachability.cjs",
    "check:docs-drift": "node scripts/check-docs-drift.cjs",
    "docs:sync": "node scripts/check-docs-drift.cjs --write",
    "check:i18n-locales": "tsx scripts/i18n-locale-coverage.ts",
    "check:i18n-locales:strict": "tsx scripts/i18n-locale-coverage.ts --fail-on-missing",
    "i18n:export-handoff": "tsx scripts/i18n-locale-coverage.ts --export-handoff",
    "i18n:check-handoff": "tsx scripts/i18n-locale-coverage.ts --check-handoff",
    "i18n:import-handoff": "tsx scripts/i18n-locale-coverage.ts --import-handoff",
    "deploy:prod": "pnpm run check:prod-config && pnpm run check:migration-dual-track && pnpm run build && pnpm -r run deploy:prod",
    "feature:create": "node scripts/migration/create-feature.js",
    "feature:migrate": "node scripts/migration/migrate-routes.js",
    "feature:update-imports": "node scripts/migration/update-imports.js",
    "test:qr-codes": "cd apps/api && pnpm run test -- src/features/qr-codes",
    "build:qr-codes": "cd apps/api && pnpm run build",
    "build:queue-core": "pnpm --filter @makanmasak/queue-core run build",
    "build:queue-service": "pnpm --filter @makanmasak/queue-service run build",
    "dev:queue-core": "pnpm --filter @makanmasak/queue-core run dev",
    "dev:queue-service": "pnpm --filter @makanmasak/queue-service run dev",
    "queue:typecheck": "pnpm --filter @makanmasak/queue-core run typecheck && pnpm --filter @makanmasak/queue-service run typecheck",
    "test:performance": "artillery run tests/performance/artillery-api-ci.yml",
    "test:performance:ws": "artillery run tests/performance/artillery-realtime-ci.yml",
    "test:performance:report": "artillery report artillery-report.json --output artillery-report.html",
    "test:load:peak": "artillery run tests/performance/artillery-lunch-peak.yml --output artillery-lunch-peak-report.json",
    "test:soak": "artillery run tests/performance/artillery-soak-test.yml --output artillery-soak-report.json",
    "test:stress": "artillery run tests/performance/artillery-stress-test.yml --output artillery-stress-report.json",
    "test:db:benchmark": "pnpm test tests/performance/db-benchmarks/query-performance.test.ts",
    "test:db:n1": "pnpm test tests/performance/db-benchmarks/n-plus-one-detection.test.ts",
    "test:db:compare": "cd tests/performance/db-benchmarks && pnpm exec tsx compare-performance.ts --fail-on-regression",
    "test:visual": "npx playwright test --config playwright.visual.config.ts --pass-with-no-tests",
    "test:visual:update": "npx playwright test --config playwright.visual.config.ts --update-snapshots --pass-with-no-tests",
    "test:security": "bash tests/security/run-zap-scan.sh",
    "test:security:snyk": "snyk test --all-projects --severity-threshold=high",
    "test:security:full": "pnpm run test:security:snyk && pnpm run test:security",
    "check:workers": "turbo run build --filter=@makanmasak/api --filter=@makanmasak/management-api --filter=@makanmasak/image-processor --filter=@makanmasak/realtime --filter=@makanmasak/backup-scheduler",
    "migration:init": "node scripts/migration-progress-tracker.js init",
    "migration:update": "node scripts/migration-progress-tracker.js update",
    "migration:report": "node scripts/migration-progress-tracker.js report",
    "migration:dashboard": "node scripts/migration-progress-tracker.js report",
    "contract:check": "node scripts/check-api-contracts.cjs",
    "contract:update": "node scripts/check-api-contracts.cjs --update",
    "contract:report": "node scripts/check-api-contracts.cjs --report",
    "prepare": "husky"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{ts,tsx,js,jsx,cjs,mjs}": [
      "eslint --fix --no-warn-ignored --quiet",
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,cjs,mjs,json,md,vue}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "restaurant",
    "ordering-system",
    "cloudflare",
    "serverless",
    "vue.js",
    "typescript",
    "pwa"
  ],
  "author": "MakanMakan Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@openai/codex-security": "^0.1.4",
    "@playwright/test": "^1.57.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.5",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.6",
    "artillery": "^2.0.27",
    "better-sqlite3": "^12.6.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.6.2",
    "glob": "^13.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "sql.js": "^1.13.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.1.0",
    "vue-eslint-parser": "^10.2.0",
    "wrangler": "^4.127.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "drizzle-orm": "0.45.2",
      "better-sqlite3": "12.6.0",
      "incur>zod": "^4.3.6",
      "uuid": "^14.0.0",
      "@grpc/grpc-js": "^1.14.4",
      "@isaacs/brace-expansion": "^5.0.1",
      "@opentelemetry/core": "^2.8.0",
      "@protobufjs/utf8": "^1.1.1",
      "@types/node": "^25.0.5",
      "ajv@^6": "^6.14.0",
      "brace-expansion@^1": "^1.1.13",
      "brace-expansion@^2": "^2.0.3",
      "brace-expansion@^4 || ^5": "^5.0.6",
      "baseline-browser-mapping": "2.10.37",
      "caniuse-lite": "1.0.30001799",
      "dompurify": "^3.4.11",
      "fast-xml-builder": "^1.1.7",
      "fast-xml-parser": "^5.7.0",
      "flatted": "^3.4.2",
      "follow-redirects": "^1.16.0",
      "form-data": "^4.0.6",
      "hono": "^4.12.25",
      "joi": "^17.13.4",
      "js-yaml@^3": "^3.15.0",
      "js-yaml@^4": "^4.2.0",
      "js-cookie": "^3.0.7",
      "jsdom": "^27.4.0",
      "lodash": "^4.18.1",
      "lodash-es": "^4.18.1",
      "minimatch@^3": "^3.1.4",
      "minimatch@^5": "^5.1.8",
      "minimatch@^9": "^9.0.7",
      "minimatch@^10": "^10.2.3",
      "path-to-regexp@^0.1": "^0.1.13",
      "picomatch@^2": "^2.3.2",
      "picomatch@^4": "^4.0.4",
      "postcss": "^8.5.10",
      "protobufjs": "^7.6.3",
      "qs@^6": "^6.14.2",
      "rollup": "^4.59.0",
      "serialize-javascript": "^7.0.5",
      "socket.io-parser": "^4.2.6",
      "terser": "^5.48.0",
      "undici": "^6.27.0",
      "vite@^5 || ^6 || ^7": "^7.3.5",
      "vitest": "^4.1.0",
      "ws": "^8.21.0",
      "yaml@^2": "^2.8.3"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "workerd"
    ]
  }
}
