{
  "name": "@makanmasak/print-agent",
  "version": "2.0.0",
  "description": "Local print agent for MakanMasak restaurants",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy:prod": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@makanmasak/database": "workspace:*",
    "@makanmasak/queue-core": "workspace:*",
    "@makanmasak/shared-types": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^25.0.5",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^8.44.0",
    "tsx": "^4.21.0",
    "typescript": "^5.1.6",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "makanmasak",
    "print",
    "agent",
    "local",
    "pos",
    "receipt"
  ],
  "author": "MakanMasak Development Team",
  "license": "MIT"
}
