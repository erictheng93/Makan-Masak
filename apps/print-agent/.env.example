# Print Agent local configuration — copy to .env in this directory.
# The agent exits at startup if PRINT_AGENT_API_KEY is missing (src/config/defaults.ts).

# REQUIRED — shared secret for HTTP/WS auth; min 10 chars (src/config/validation.ts)
PRINT_AGENT_API_KEY=replace-with-a-long-random-string

# Restaurant this agent prints for (default: "default")
RESTAURANT_ID=default

# OPTIONAL — credential for pulling print jobs from the cloud. Issue it from the
# admin UI (/dashboard/print-agents, i.e. POST /api/v1/pos/print-agents); it is
# shown once. Bound to a till, the agent gets that till's receipts; unbound
# (whole shop), it gets the kitchen tickets. Leave unset to run as a local-only
# print server.
PRINT_AGENT_CLOUD_KEY=

# Ports (defaults shown)
PRINT_AGENT_PORT=3003
PRINT_AGENT_WS_PORT=3004

# Cloud API the agent reports to (default: local dev API worker)
CLOUD_API_ENDPOINT=http://localhost:8787/api/v1

# Comma-separated CORS origins for the local HTTP API (default: *)
ALLOWED_ORIGINS=*

# Printer discovery (defaults shown)
AUTO_DISCOVERY=true
DISCOVERY_INTERVAL=30000
HEARTBEAT_INTERVAL=60000

# Print queue (defaults shown)
MAX_QUEUE_SIZE=100
MAX_RETRIES=3
RETRY_DELAY=5000
