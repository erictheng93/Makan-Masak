{
  "name": "@makanmasak/backup-scheduler",
  "version": "1.0.0",
  "description": "Cloudflare Workers cron entry for scheduled backups (worker code lives in apps/api)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\"",
    "build:prod": "wrangler deploy --dry-run --env production",
    "typecheck": "pnpm --filter @makanmasak/api typecheck",
    "lint": "pnpm --filter @makanmasak/api lint",
    "test": "pnpm run build",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production"
  },
  "devDependencies": {
    "wrangler": "^4.131.1"
  }
}
