{
  "name": "@makanmasak/realtime",
  "version": "1.0.0",
  "description": "Real-time communication service using Durable Objects",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ../../.wrangler/shared-state --inspector-port 9233",
    "build": "tsc && wrangler deploy --dry-run --env=\"\"",
    "build:prod": "tsc && wrangler deploy --dry-run --env production",
    "deploy:prod": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@makanmasak/shared-types": "workspace:*",
    "hono": "^4.12.24",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.1"
  }
}
