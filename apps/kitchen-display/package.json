{
  "name": "makanmasak-kitchen-display",
  "version": "1.0.0",
  "description": "MakanMasak 廚房顯示系統",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:full": "vue-tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:real-integration": "vitest --config vitest.real-integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "deploy:prod": "pnpm run build && wrangler pages deploy dist --project-name=makanmasak-kitchen"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.0",
    "@makanmasak/auth-client": "workspace:*",
    "@makanmasak/i18n": "workspace:*",
    "@makanmasak/shared": "workspace:*",
    "@tanstack/vue-query": "^5.17.0",
    "@vueuse/core": "^10.7.0",
    "@vueuse/integrations": "^10.7.0",
    "axios": "^1.17.0",
    "date-fns": "^3.0.0",
    "howler": "^2.2.4",
    "lucide-vue-next": "^0.344.0",
    "pinia": "^2.1.0",
    "sortablejs": "^1.15.2",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@types/howler": "^2.2.11",
    "@types/node": "^25.0.5",
    "@types/sortablejs": "^1.15.8",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "terser": "^5.48.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.5",
    "vitest": "^4.0.17",
    "vue-tsc": "^3.0.6",
    "wrangler": "^4.131.1"
  }
}
