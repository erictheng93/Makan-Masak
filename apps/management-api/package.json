{
  "name": "@makanmasak/management-api",
  "version": "1.0.0",
  "description": "Central management API for MakanMasak hybrid deployment",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ../../.wrangler/shared-state --inspector-port 9230",
    "build": "wrangler deploy --dry-run --env=\"\"",
    "build:prod": "wrangler deploy --dry-run --env production",
    "deploy": "node -e \"console.error('Refusing unqualified deploy. Use pnpm run deploy:prod.'); process.exit(1)\"",
    "deploy:prod": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:real-integration": "vitest --config vitest.real-integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.5.0",
    "@makanmasak/utils": "workspace:*",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.24",
    "pinyin-pro": "^3.28.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@makanmasak/database": "workspace:*",
    "@makanmasak/shared-types": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.0.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.1"
  }
}
