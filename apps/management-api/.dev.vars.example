# Local Development Environment Variables — management-api (port 8789)
# Copy this file to .dev.vars and fill in the values.
# IMPORTANT: Never commit .dev.vars to version control (it is gitignored).

# JWT secret used to VERIFY tokens issued by apps/api.
#
# ⚠️ This MUST be byte-for-byte identical to apps/api/.dev.vars JWT_SECRET.
# The admin dashboard logs in against apps/api, then calls
# POST /api/v1/auth/exchange here to swap that token for a management token.
# /auth/exchange verifies the incoming apps/api token with this exact
# JWT_SECRET (see src/routes/auth.ts). If the two workers' secrets differ,
# exchange fails with 401 "Invalid or expired API token" and the platform
# onboarding page (/dashboard/platform/onboarding) cannot load.
JWT_SECRET=your-secure-jwt-secret-min-32-chars-long-change-this-value

# Shared token for apps/api -> apps/management-api internal service calls.
# This MUST be byte-for-byte identical to apps/api/.dev.vars. If unset or
# mismatched, internal tenant provisioning routes return 401.
INTERNAL_API_TOKEN=your-local-internal-api-token-min-32-chars-change-this-value

# Optional: dedicated secret for SIGNING management tokens.
# If unset, management token signing falls back to JWT_SECRET
# (managementJwtSecret() = MANAGEMENT_JWT_SECRET || JWT_SECRET). The
# management auth middleware verifies with the same fallback, so setting this
# is optional locally and does not affect the exchange-verify step above.
# MANAGEMENT_JWT_SECRET=your-dedicated-management-secret-min-32-chars

# Optional platform onboarding alert fallback. Cloudflare Email Service's local
# binding logs mail by default; use a verified sender and destination only when
# testing a real remote binding. Details: ONBOARDING_NOTIFICATIONS.md.
# PLATFORM_NOTIFICATION_EMAIL=ops@example.com
# PLATFORM_NOTIFICATION_EMAIL_FROM=alerts@your-verified-sender-domain.example
