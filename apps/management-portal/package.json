{
  "name": "@makanmasak/management-portal",
  "version": "1.0.0",
  "description": "MakanMasak 多租戶管理後台 - 管理獨立部署租戶",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "deploy:prod": "wrangler pages deploy dist --project-name=makanmasak-management"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.0",
    "@heroicons/vue": "^2.0.0",
    "@makanmasak/i18n": "workspace:*",
    "@makanmasak/utils": "workspace:*",
    "@tailwindcss/forms": "^0.5.0",
    "@vueuse/core": "^10.7.0",
    "axios": "^1.17.0",
    "chart.js": "^4.5.0",
    "date-fns": "^3.0.0",
    "lodash-es": "^4.17.0",
    "lucide-vue-next": "^0.344.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.27",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.2.0",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.0",
    "@types/lodash-es": "^4.17.0",
    "@types/node": "^25.0.5",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.0.6",
    "wrangler": "^4.131.1"
  }
}
