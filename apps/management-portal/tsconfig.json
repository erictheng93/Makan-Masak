{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@makanmasak/i18n": ["../../packages/shared/src/i18n/src/index.ts"],
      "@makanmasak/i18n/locale-manager": [
        "../../packages/shared/src/i18n/src/locale-manager.ts"
      ],
      "@makanmasak/i18n/static-messages": [
        "../../packages/shared/src/i18n/src/static-messages.ts"
      ],
      "@makanmasak/i18n/types": ["../../packages/shared/src/i18n/src/types.ts"],
      "@makanmasak/utils": ["../../packages/utils/src"],
      "@makanmasak/utils/*": ["../../packages/utils/src/*"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
