{
  "name": "makanmasak-customer-app",
  "version": "1.0.0",
  "description": "MakanMasak 消費者點餐應用",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc && vite build && node ../../scripts/check-csp-safe-bundle.cjs dist",
    "build:analyze": "cross-env ANALYZE=true vue-tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest",
    "test:real-integration": "vitest --config vitest.real-integration.config.ts",
    "deploy:prod": "wrangler pages deploy dist --project-name=makanmasak-customer"
  },
  "dependencies": {
    "@chenfengyuan/vue-qrcode": "^2.0.0",
    "@headlessui/vue": "^1.7.0",
    "@heroicons/vue": "^2.0.0",
    "@makanmasak/i18n": "workspace:*",
    "@makanmasak/shared": "workspace:*",
    "@makanmasak/shared-types": "workspace:*",
    "@makanmasak/utils": "workspace:*",
    "@tailwindcss/forms": "^0.5.0",
    "@tailwindcss/typography": "^0.5.0",
    "@tanstack/vue-query": "^5.0.0",
    "@vueuse/components": "^10.0.0",
    "@vueuse/core": "^10.0.0",
    "@zxing/library": "^0.20.0",
    "autoprefixer": "^10.5.0",
    "axios": "^1.17.0",
    "dayjs": "^1.11.0",
    "lodash-es": "^4.17.0",
    "maplibre-gl": "^5.24.0",
    "pinia": "^2.1.0",
    "pmtiles": "^4.4.1",
    "postcss": "^8.4.0",
    "qrcode-reader": "^1.0.4",
    "tailwindcss": "^3.4.0",
    "vue": "^3.4.27",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.0",
    "vue-toastification": "^2.0.0-rc.5",
    "workbox-window": "^7.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.0",
    "cross-env": "^10.1.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.0.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "^5.3.0",
    "vite": "^7.3.2",
    "vite-plugin-compression2": "^2.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.0.6",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.127.1"
  }
}
