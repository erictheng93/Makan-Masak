# Staging build (vite build --mode staging). Public URLs only, no secrets.
# __WORKERS_SUBDOMAIN__ is filled in by scripts/staging/provision.cjs.
# See docs/runbooks/staging.md.
VITE_API_BASE_URL=https://api-staging.makanmasak.com/api/v1
VITE_WS_BASE_URL=wss://api-staging.makanmasak.com
VITE_REALTIME_URL=wss://makanmasak-realtime-staging.omfg.workers.dev
VITE_REALTIME_WS_URL=wss://makanmasak-realtime-staging.omfg.workers.dev
VITE_NODE_ENV=production
