# Customer App — development environment template
#
# The real .env.development is committed and provides team-shared defaults.
# Copy this file to .env.development.local to override any value for your
# personal setup (port collisions, remote API, etc.). .env.development.local
# is gitignored.
#
#   cp .env.development.example .env.development.local

# API base path — proxied by Vite to the local Worker (see vite.config.ts)
VITE_API_BASE_URL=/api/v1

# Realtime WebSocket (Durable Objects) — default port 8788
VITE_WS_BASE_URL=ws://localhost:8788

VITE_APP_ENV=development
VITE_DEBUG_MODE=true
VITE_REALTIME_URL=ws://localhost:8788

# Where the demo shop's "open your own shop" button goes.
VITE_ONBOARDING_URL=http://localhost:3011
