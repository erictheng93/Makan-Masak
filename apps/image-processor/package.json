{
  "name": "@makanmasak/image-processor",
  "version": "1.0.0",
  "description": "Cloudflare Workers-based image processing service for MakanMasak",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --persist-to ../../.wrangler/shared-state --inspector-port 9234",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "build": "tsc && wrangler deploy --dry-run --env=\"\"",
    "build:prod": "tsc && wrangler deploy --dry-run --env production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:real-integration": "vitest run --config vitest.real-integration.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "cloudflare-workers",
    "image-processing",
    "image-optimization",
    "restaurant-management"
  ],
  "author": "MakanMasak Team",
  "license": "MIT",
  "dependencies": {
    "@makanmasak/database": "workspace:*",
    "@makanmasak/shared-types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.24",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^25.0.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^8.57.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.1"
  }
}
