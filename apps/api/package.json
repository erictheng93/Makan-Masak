{
  "name": "@makanmasak/api",
  "version": "1.0.0",
  "description": "MakanMasak API server built with Hono and Cloudflare Workers",
  "main": "dist/index.js",
  "scripts": {
    "dev": "wrangler dev --persist-to ../../.wrangler/shared-state --inspector-port 9229",
    "build": "wrangler deploy --dry-run --env=\"\"",
    "build:prod": "wrangler deploy --dry-run --env production",
    "deploy": "node -e \"console.error('Refusing unqualified deploy. Use pnpm run deploy:prod.'); process.exit(1)\"",
    "deploy:prod": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:real-integration": "cross-env NODE_OPTIONS='--max-old-space-size=8192' vitest run --config vitest.real-integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.4",
    "@hono/zod-validator": "^0.2.0",
    "@makanmasak/ai-analytics": "workspace:*",
    "@makanmasak/database": "workspace:*",
    "@makanmasak/queue-core": "workspace:*",
    "@makanmasak/shared-types": "workspace:*",
    "@makanmasak/utils": "workspace:*",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.4.1",
    "fflate": "^0.8.2",
    "hono": "^4.12.24",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@hono/node-server": "^1.19.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-orm": "^0.45.2",
    "sql.js": "^1.13.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.1"
  }
}
