{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    // ES2022, matching every other app and the root config. This was the only
    // project left on ES2020; it typechecks packages/database source through
    // the @makanmasak/database path mapping, and that source uses ES2022 APIs
    // such as Array.prototype.at().
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@makanmasak/i18n": ["../../packages/shared/src/i18n/src/index.ts"],
      "@makanmasak/i18n/locale-manager": [
        "../../packages/shared/src/i18n/src/locale-manager.ts"
      ],
      "@makanmasak/i18n/static-messages": [
        "../../packages/shared/src/i18n/src/static-messages.ts"
      ],
      "@makanmasak/i18n/types": ["../../packages/shared/src/i18n/src/types.ts"],
      "@makanmasak/shared": ["../../packages/shared"],
      "@makanmasak/shared/*": ["../../packages/shared/*"],
      "@makanmasak/database": ["../../packages/database/src"],
      "@makanmasak/database/*": ["../../packages/database/src/*"],
      "pinia": ["./node_modules/pinia"],
      "vue": ["./node_modules/vue"],
      "@shared/*": ["../../packages/shared-types/src/*"],
      "@makanmasak/shared-types": ["../../packages/shared-types/src"],
      "@makanmasak/shared-types/*": ["../../packages/shared-types/src/*"],
      "@makanmasak/utils": ["../../packages/utils/src"],
      "@makanmasak/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "../../packages/shared/components/ModuleGate.vue",
    "../../packages/shared/composables/useModuleAccess.ts",
    "../../packages/shared/stores/moduleAccess.ts",
    "../../packages/shared/types/module-access.ts",
    "../../packages/shared/utils/chart-palette.ts",
    "../../packages/shared/utils/unknown.ts",
    "../../packages/shared/utils/user-facing-error.ts",
    "../../packages/shared-types/src/**/*",
    "../../packages/shared/src/i18n/src/**/*",
    "../../packages/utils/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.stories.ts",
    "**/__tests__/**",
    "**/tests/**"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
