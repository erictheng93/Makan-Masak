{
  "name": "makanmasak-admin-dashboard",
  "version": "1.0.0",
  "description": "MakanMasak 管理後台",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc && vite build && node ../../scripts/check-csp-safe-bundle.cjs dist",
    "build:analyze": "cross-env ANALYZE=true vue-tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "cross-env NODE_OPTIONS='--max-old-space-size=6144' vue-tsc -p tsconfig.json --noEmit && cross-env NODE_OPTIONS='--max-old-space-size=6144' vue-tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:real-integration": "vitest --config vitest.real-integration.config.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "deploy:prod": "wrangler pages deploy dist --project-name=makanmasak-admin"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.0",
    "@heroicons/vue": "^2.0.0",
    "@makanmasak/ai-analytics": "workspace:*",
    "@makanmasak/auth-client": "workspace:*",
    "@makanmasak/i18n": "workspace:*",
    "@makanmasak/shared": "workspace:*",
    "@makanmasak/shared-types": "workspace:*",
    "@stripe/stripe-js": "^4.0.0",
    "@tailwindcss/forms": "^0.5.0",
    "@vueuse/core": "^10.7.0",
    "axios": "^1.17.0",
    "chart.js": "^4.5.0",
    "date-fns": "^3.0.0",
    "jspdf": "^4.2.1",
    "lodash-es": "^4.17.0",
    "lucide-vue-next": "^0.344.0",
    "papaparse": "^5.5.3",
    "pinia": "^2.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.4.27",
    "vue-chartjs": "^5.3.2",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.0",
    "vue-toastification": "^2.0.0-rc.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.0",
    "@types/lodash-es": "^4.17.0",
    "@types/node": "^25.0.5",
    "@types/papaparse": "^5.5.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^10.1.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.5",
    "vitest": "^4.0.17",
    "vue-tsc": "^3.0.6",
    "wrangler": "^4.131.1"
  }
}
